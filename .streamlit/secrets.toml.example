# Copiá este archivo a .streamlit/secrets.toml y completá los valores.
# secrets.toml está en .gitignore; este ejemplo sí se versiona.

DATABASE_URL = "postgresql+psycopg2://usuario:contraseña@localhost:5432/marfil"

# Datos de pago que se insertan en los recordatorios de WhatsApp.
# Mientras alguno falte o contenga "XX", la app bloquea el envío de recordatorios.
[datos_pago]
banco = ""       # ej. "BNC (0191)"
documento = ""   # ej. "V-12.345.678"
telefono = ""    # ej. "0412-1234567"
titular = ""     # opcional
